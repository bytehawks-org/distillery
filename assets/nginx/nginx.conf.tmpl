# change the parameters (env, CLI, config file) and run `shaker init nginx`.
worker_processes {{ BH_NGINX_WORKER_PROCESSES }};
pid {{ BH_PKG_PREFIX }}/run/nginx.pid;
error_log stderr info;

events {
    worker_connections 1024;
}

http {
    access_log {{ BH_NGINX_ACCESS_LOG }};
    server_tokens {{ BH_NGINX_SERVER_TOKENS }};
    client_body_temp_path {{ BH_PKG_PREFIX }}/run/client_body;
    proxy_temp_path       {{ BH_PKG_PREFIX }}/run/proxy;
    fastcgi_temp_path     {{ BH_PKG_PREFIX }}/run/fastcgi;
    uwsgi_temp_path       {{ BH_PKG_PREFIX }}/run/uwsgi;
    scgi_temp_path        {{ BH_PKG_PREFIX }}/run/scgi;

    server {
        listen {{ BH_NGINX_PORT }};
        server_name {{ BH_NGINX_SERVER_NAME }};
        root {{ BH_PKG_PREFIX }}/html;

        location / {
            index index.html;
        }
    }
}
