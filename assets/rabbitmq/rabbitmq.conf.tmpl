# Rendered by Shaker at every start from the BH_RABBITMQ_* parameters. Do not edit: change the parameters.
listeners.tcp.default = {{ BH_RABBITMQ_PORT }}
management.tcp.port = {{ BH_RABBITMQ_MANAGEMENT_PORT }}
default_user = {{ BH_RABBITMQ_USER }}
default_pass = {{ BH_RABBITMQ_PASSWORD }}
default_vhost = {{ BH_RABBITMQ_VHOST }}
loopback_users = none
log.console = true
log.file = false
